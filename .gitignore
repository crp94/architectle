# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# editor / tooling
.idea/
.superpowers/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated curated data (regenerated by `postinstall` / `npm run data:curate`)
src/data/curated-*.json

# research aid output from `npm run data:seed` — never shipped data
reports/
.claude/worktrees/

# curator scratch scripts (Wikipedia/Wikidata/Commons research helpers) —
# benign, per-agent, never shipped data
.curation-scratch/
